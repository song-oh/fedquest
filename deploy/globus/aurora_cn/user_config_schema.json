{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "queue": {
      "type": "string",
      "enum": [
        "capacity",
        "debug",
        "debug-scaling"
      ]
    },
    "nodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "walltime": {
      "type": "string",
      "pattern": "^[0-9]{1,3}:[0-5][0-9]:[0-5][0-9]$"
    },
    "account": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "min_blocks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    }
  }
}
